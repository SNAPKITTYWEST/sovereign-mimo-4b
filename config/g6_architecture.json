{
  "model_name": "Sovereign-MiMo-G6",
  "model_family": "mimo-g6",
  "version": "1.0",
  "origin": "speculative from MiMo-7B-RL (XiaomiMiMo), extended",
  "target_architecture": "g6-6.15b",

  "architecture": {
    "type": "decoder-only-transformer",
    "norm": "rmsnorm",
    "activation": "swiglu",
    "position_encoding": "rope",
    "attention": "grouped-query"
  },

  "dimensions": {
    "d_model": 4096,
    "n_layers": 40,
    "n_heads": 32,
    "n_kv_heads": 8,
    "head_dim": 128,
    "d_ff": 11008,
    "vocab_size": 151936,
    "max_seq_len": 32768
  },

  "rope": {
    "theta": 10000.0,
    "dimension_count": 128,
    "scaling_type": "linear",
    "scaling_factor": 4.0,
    "original_context_length": 8192
  },

  "norm": {
    "type": "rmsnorm",
    "epsilon": 1e-5
  },

  "reward_head": {
    "type": "scalar",
    "hidden_size": 4096,
    "output_size": 1,
    "activation": "tanh",
    "description": "Scalar reward score [0, 1] for code quality"
  },

  "quantization": {
    "training": "bf16",
    "deployment": "Q4_K_M",
    "embeddings": "Q8_0",
    "norms": "F32"
  },

  "parameters": {
    "total_estimate": "~6.15B",
    "embedding_params": "622622720",
    "per_layer_params": "~150M",
    "reward_head_params": "8193"
  },

  "deployment": {
    "gpu_minimum": "RTX 3080 (10GB) with Q4_K_M",
    "gpu_recommended": "RTX 4090 (24GB) with Q8_0",
    "vram_estimate_q4": "~4.5 GB",
    "vram_estimate_q8": "~7.5 GB",
    "quantization_note": "Q4_K_M for BBQBADDIE, Q8_0 for A100/4090"
  }
}
